{
  "name": "@ramex-labs/irontrellis-remote-tools",
  "version": "1.0.0-rc.2.1",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "description": "Format-2 cooperative destination, durable execution and explicit outcome recovery",
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "default": "./index.mjs"
    },
    "./langchain": {
      "types": "./langchain.d.mts",
      "default": "./langchain.mjs"
    },
    "./client": "./client.mjs",
    "./destination": "./destination.mjs",
    "./durable-store": "./durable-store.mjs",
    "./executor": "./executor.mjs",
    "./recovery": "./recovery.mjs",
    "./validation": "./validation.mjs",
    "./wire": "./wire.mjs",
    "./protected-evidence": "./protected-evidence.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "*.mjs",
    "*.d.mts",
    "README.md",
    "LICENSE",
    "NOTICE",
    "LICENSING.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "dependencies": {
    "@ramex-labs/irontrellis": "workspace:*"
  },
  "peerDependencies": {
    "@langchain/core": "^1.2.18",
    "zod": "4.6.7"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@langchain/core": "1.3.2",
    "zod": "4.6.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zerohourzulu/irontrellis.git",
    "directory": "packages/remote-tools"
  }
}
